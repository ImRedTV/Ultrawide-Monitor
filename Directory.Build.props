<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Company>Gil Breysse (RED)</Company>
    <Product>Ultrawide Monitor</Product>
    <Description>Gestionnaire de zones de fenêtres pour écrans ultralarges sous Windows 11.</Description>
    <Copyright>Copyright © 2026 Gil Breysse (RED)</Copyright>
    <RepositoryUrl>https://github.com/ImRedTV/Ultrawide-Monitor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
